# Copy to .env.live; never commit that file. See docs/m2-live-run.md.
# Compose reads this file and the runbook sources it in a shell: no spaces, quotes, $, ;, &, |, backticks or backslashes in values.
# PayPal sandbox app client id; copy from your app in the PayPal developer dashboard (sandbox).
PAYPAL_CLIENT_ID=
# PayPal sandbox app secret; copy from your app in the PayPal developer dashboard (sandbox).
PAYPAL_CLIENT_SECRET=
# Application secret; generate separately: openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'.
LOCAL_APP_SECRET=
# Ops secret; generate separately: openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'.
LOCAL_OPS_SECRET=
# Agent secret; generate separately: openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'.
LOCAL_AGENT_SECRET=
# Bare stable ngrok host from ngrok http 4000, without scheme, port or path.
PUBLIC_HOST=
# Notification signing secret; generate: openssl rand -hex 32.
LEDGER_NOTIFICATION_SECRET=
# Agent dispatch token; generate: openssl rand -hex 32.
AGENT_SERVICE_TOKEN=
# DeepSeek API key; obtain from the human operator.
DEEPSEEK_API_KEY=
# Langfuse public key; generate: echo "pk-lf-$(openssl rand -hex 16)".
LANGFUSE_PUBLIC_KEY=
# Langfuse secret key; generate: echo "sk-lf-$(openssl rand -hex 16)".
LANGFUSE_SECRET_KEY=
# Langfuse session secret; generate: openssl rand -base64 32.
LANGFUSE_NEXTAUTH_SECRET=
# Langfuse salt; generate: openssl rand -base64 32.
LANGFUSE_SALT=
# Langfuse encryption key; generate: openssl rand -hex 32.
LANGFUSE_ENCRYPTION_KEY=
# Langfuse administrator email; choose a local administrator address.
LANGFUSE_ADMIN_EMAIL=
# Langfuse administrator password; generate a strong password in your password manager.
LANGFUSE_ADMIN_PASSWORD=
