# Database configuration variables
# In development you can find them in the file docker-compose.yml
DB_HOST=localhost
DB_PORT=5432
DB_USER=adminer
DB_PASSWORD=secret123
DB_NAME=food_delivery

# Secret phrase to sign your json web tokens
SECRET_KEY=itsVerySecret

# These variables are only necessary if you are going to use the mail delivery
# Here you put the credentials of your service
MAIL_HOST="YOUR_MAIL_HOST"
MAIL_PORT="YOUR_MAIL_PORT"
MAIL_USER="YOUR_MAIL_USER"
MAIL_PASSWORD="YOUR_MAIL_PASSWORD"
# Backs GraphQL subscriptions across replicas
REDIS_HOST=localhost
REDIS_PORT=6380

# Shared secret for verifying fulfillment provider webhooks
FULFILLMENT_SIGNING_SECRET=mock-secret

# Enable ledger checkout only when its connection settings are provisioned.
LEDGER_CHECKOUT=disabled
# Ledger API address for this dispatch process.
# LEDGER_BASE_URL=http://localhost:8080
# Application bearer credential; supply a real local token outside version control.
# LEDGER_APP_TOKEN=app_placeholder
# HTTPS return address after checkout approval.
# LEDGER_CHECKOUT_SUCCESS_URL=https://example.com/checkout/return
# HTTPS return address after checkout cancellation.
# LEDGER_CHECKOUT_CANCEL_URL=https://example.com/checkout/cancel
# Timeout for a ledger request in milliseconds.
# LEDGER_TIMEOUT_MS=10000

# Shared notification HMAC secret, at least 32 bytes; required when checkout is enabled.
# LEDGER_NOTIFICATION_SECRET=replace-with-at-least-32-random-bytes
