DB_HOST=localhost
DB_PORT=5432
DB_USER=adminer
DB_PASSWORD=secret123
DB_NAME=food_delivery_test
SECRET_KEY=itsVerySecret
# Deliberately a closed local port: MailService is overridden in e2e, and if an
# override is ever missed this fails with ECONNREFUSED immediately instead of
# hanging on a TCP timeout to a real host.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=dev
MAIL_PASSWORD=dev

# Backs GraphQL subscriptions across replicas
REDIS_HOST=localhost
REDIS_PORT=6380

# Shared secret for verifying fulfillment provider webhooks
FULFILLMENT_SIGNING_SECRET=mock-secret

OUTBOX_POLLING=disabled
